# Space-Track.org credentials
SPACETRACK_USER=your@email.com
SPACETRACK_PASS=your_password

# OURE configuration
OURE_LOG_LEVEL=INFO
OURE_LOG_FORMAT=json # json | console
OURE_MC_SAMPLES=1000
OURE_SCREENING_DIST_KM=5.0
OURE_DEFAULT_COV_SIGMA_KM=0.5
OURE_SOLAR_FLUX_OVERRIDE=150.0
OURE_TLE_MAX_AGE_HOURS=24
OURE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
